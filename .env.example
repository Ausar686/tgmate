TELEGRAM_BOT_TOKEN=
OWNER_USER_ID=

DATABASE_URL=
LOG_LEVEL=
SOURCE_URL=

# The bot's own Bot API server (docs/deployment.md): files up to 2000 MB instead of 20 MB in and 50 MB out.
TELEGRAM_API_URL=
# The largest file users can send, in MB (default 20).
DOWNLOAD_LIMIT_MB=

# Docker Compose only: the container's memory limit (default 2g).
BOT_MEMORY_LIMIT=
# Docker Compose only, for the bot's own Bot API server: COMPOSE_PROFILES=bot-api runs it, with the API ID and hash
# from my.telegram.org.
COMPOSE_PROFILES=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
